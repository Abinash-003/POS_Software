# ---------------------------------------------------------------------------
# Copy this file to server/.env (backend) and client/.env (frontend).
# ---------------------------------------------------------------------------

# ============================ server/.env ==================================
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (database name must be part of the URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supermarket_pos?retryWrites=true&w=majority&appName=Cluster0

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=sm_token

# Comma separated list of allowed browser origins (no trailing slash)
# Local Vite ports + live Vercel frontend:
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173,https://pos-software-ecru.vercel.app

# Uploads
MAX_UPLOAD_MB=4

# Credentials created the first time the server boots with an empty database
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Owner

# ============================ client/.env ==================================
# Local (leave blank to use the Vite proxy):
# VITE_API_URL=

# Production (Vercel) — also set this in the Vercel dashboard and redeploy:
# VITE_API_URL=https://pos-software-system.onrender.com/api
