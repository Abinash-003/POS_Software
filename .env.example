# ---------------------------------------------------------------------------
# Copy this file to server/.env (backend) and client/.env (frontend).
# ---------------------------------------------------------------------------

# ============================ server/.env ==================================
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (database name must be part of the URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supermarket_pos?retryWrites=true&w=majority&appName=Cluster0

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=sm_token

# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=4

# Credentials created the first time the server boots with an empty database
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Owner

# ============================ client/.env ==================================
# VITE_API_URL=http://localhost:5000/api
